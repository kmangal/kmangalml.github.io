{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% capture footer_social %}
  {% if site.data.socials.email or site.data.socials.linkedin_username or site.data.socials.github_username %}
    <div class="site-footer-social">
      <p>Find me on: </p>
      {% if site.data.socials.email %}
        {% if site.protect_email %}
          {% assign email_parts = site.data.socials.email | split: '@' %}
          <a href="#" class="al-email-protect" data-eu="{{ email_parts[0] }}" data-ed="{{ email_parts[1] }}">
            <i class="fa-solid fa-envelope"></i> Email
          </a>
        {% else %}
          <a href="mailto:{{ site.data.socials.email }}">
            <i class="fa-solid fa-envelope"></i> Email
          </a>
        {% endif %}
      {% endif %}
      {% if site.data.socials.linkedin_username %}
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-linkedin"></i> LinkedIn
        </a>
      {% endif %}
      {% if site.data.socials.github_username %}
        <a href="https://github.com/{{ site.data.socials.github_username }}" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-github"></i> GitHub
        </a>
      {% endif %}
    </div>
  {% endif %}
{% endcapture %}

{% comment %}
  Uses --global-text-color rather than --global-footer-link-color: the latter
  is tuned for the fixed-bottom footer's own inverted background, which the
  sticky-bottom variant (footer_fixed: false, in use here) never sets.
{% endcomment %}
<style>
  .site-footer-social {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.35rem 1rem;
    margin-bottom: 0.75rem;
  }

  .site-footer-social a {
    display: inline-flex;
    align-items: center;
    color: var(--global-text-color);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .site-footer-social a i {
    width: 1.1rem;
    margin-right: 0.4rem;
    font-size: 1rem;
    text-align: center;
  }

  .site-footer-social a:hover {
    color: var(--global-theme-color);
  }

  .site-footer-social p {
    margin: 0;
    color: var(--global-text-color);
  }
</style>

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_social }}
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center.liquid %}
      {% else %}
        {% include newsletter.liquid %}
      {% endif %}
    {% endif %}

    <div class="container">
      {{ footer_social }}
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
